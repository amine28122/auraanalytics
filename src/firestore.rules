rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // وظيفة للتحقق هل المستخدم هو "أدمن"
    // تعتمد على وجود حقل isAdmin بقيمة true في مستند المستخدم
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // وظيفة للتحقق هل المستخدم هو صاحب المستند
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 1. حماية مجموعة المستخدمين
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      // حماية التحليلات داخل حساب المستخدم
      match /analyses/{analysisId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // 2. حماية طلبات التفعيل والسحب
    // المستخدم يمكنه الإنشاء فقط، والأدمن يمكنه القراءة والمعالجة
    match /activationRequests/{docId} {
      allow create: if request.auth != null;
      allow read, write: if isAdmin();
    }
    
    match /withdrawRequests/{docId} {
      allow create: if request.auth != null;
      allow read, write: if isAdmin();
    }
    
    // 3. البيانات العامة (مثل الأسعار ونظام المنصة)
    match /system/prices {
      allow read: if true; // القراءة متاحة لتحديث الشارتات
      allow write: if isAdmin();
    }

    // منع أي وصول مجهول لأي مستند آخر
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}

