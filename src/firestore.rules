rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    match /activationRequests/{docId} {
      allow create: if request.auth != null;
      allow read, write: if isAdmin();
    }
    
    match /withdrawRequests/{docId} {
      allow create: if request.auth != null;
      allow read, write: if isAdmin();
    }
    
    match /system/prices {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // REVIEWS COLLECTION
    // ==========================================
    match /reviews/{reviewId} {
      // Anyone (even unauthenticated) can submit a review
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.review is string
                    && request.resource.data.review.size() >= 20;
      
      // Anyone can read approved reviews
      allow read: if resource.data.status == 'approved' || isAdmin();
      
      // Only admin can update (approve/reject) or delete
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
